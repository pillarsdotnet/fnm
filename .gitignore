# This directory is both the packaging tree and a working copy of upstream's
# source at the packaged tag. Only debian/ and .forgejo/ are ours, so those
# are tracked and everything else is ignored: the upstream checkout, the two
# orig tarballs, and every build artifact.
/*
!/.forgejo/
!/debian/
!/README.md
!/trivy.yaml
!/.gitignore

# Build artifacts inside debian/.
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/fnm/
/debian/fnm.substvars
/debian/fnm.1
/debian/fnm.bash
/debian/fnm.zsh
/debian/fnm.fish
/debian/cargo-home/
/debian/home/
/debian/patches/.pc/
# The lint configuration, which must be tracked for the Lint workflow to
# find it: this file whitelists, so anything not named here is invisible
# to `git add -A` and the workflow then fails with ".pre-commit-config.yaml
# is not a file" having committed nothing.
!/.pre-commit-config.yaml
!/.vale.ini
!/.vale/
!/.markdownlint.yaml
!/.yamllint

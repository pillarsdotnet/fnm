#!/usr/bin/make -f
# Copyright (c) 2026 Robert August Vincent II <pillarsdotnet@gmail.com>
# Co-author: Claude Code.

include /usr/share/dpkg/buildopts.mk

# Every crate comes from vendor/ (the orig-vendor tarball); the builders have
# no network. A private CARGO_HOME keeps the builder's own cargo configuration,
# such as an sccache rustc-wrapper, out of the build.
export CARGO_HOME = $(CURDIR)/debian/cargo-home
unexport RUSTC_WRAPPER

# Keep the build directory out of the binary's panic locations.
export RUSTFLAGS += --remap-path-prefix=$(CURDIR)=.

# Leave stripping to dh_strip, so the -dbgsym package gets the line tables.
export CARGO_PROFILE_RELEASE_STRIP = false
export CARGO_PROFILE_RELEASE_DEBUG = line-tables-only

ifneq (,$(DEB_BUILD_OPTION_PARALLEL))
export CARGO_BUILD_JOBS = $(DEB_BUILD_OPTION_PARALLEL)
endif

# Upstream pins Rust 1.88 (rust-toolchain.toml, which plain cargo ignores).
# noble's default cargo is 1.75, so there the versioned toolchain from
# noble-updates (cargo-1.91, rustc-1.91) goes first on PATH; resolute and
# stonking use their default one.
RUST_OK := $(shell cargo --version 2>/dev/null \
	| awk '{ split($$2, v, "."); print (v[1] > 1 || v[2] >= 88) ? "yes" : "no" }')
ifneq ($(RUST_OK),yes)
export PATH := /usr/lib/rust-1.91/bin:$(PATH)
endif

# fnm writes under $HOME and its multishell state under $XDG_RUNTIME_DIR;
# keep the build-time invocations off the builder's real ones.
RUN_ENV = env HOME=$(CURDIR)/debian/home XDG_RUNTIME_DIR=$(CURDIR)/debian/home

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME) debian/home
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "%s/vendor"\n' \
		'$(CURDIR)' > $(CARGO_HOME)/config.toml
	cargo --version
	rustc --version

override_dh_auto_build:
	cargo build --release --frozen
	help2man --no-info --name 'fast and simple Node.js version manager' \
		target/release/fnm > debian/fnm.1
	$(RUN_ENV) target/release/fnm completions --shell bash > debian/fnm.bash
	$(RUN_ENV) target/release/fnm completions --shell zsh > debian/fnm.zsh
	$(RUN_ENV) target/release/fnm completions --shell fish > debian/fnm.fish

# Upstream's test suite downloads Node.js releases from nodejs.org, and the
# builders have no network; a smoke test of the built binary stands in.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	target/release/fnm --version
	$(RUN_ENV) target/release/fnm env --shell bash > /dev/null
	$(RUN_ENV) target/release/fnm list
endif

# Upstream's changelog has to reach /usr/share/doc as changelog.gz, not
# under its own name, or policy is not met (lintian:
# wrong-name-for-upstream-changelog); dh_installchangelogs renames it.
override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_auto_install:
	install -D -m 0755 target/release/fnm debian/fnm/usr/bin/fnm
	install -D -m 0644 debian/fnm.bash \
		debian/fnm/usr/share/bash-completion/completions/fnm
	install -D -m 0644 debian/fnm.zsh \
		debian/fnm/usr/share/zsh/vendor-completions/_fnm
	install -D -m 0644 debian/fnm.fish \
		debian/fnm/usr/share/fish/vendor_completions.d/fnm.fish

# dh_clean deletes *.orig files, but every vendored crate ships a
# Cargo.toml.orig that its .cargo-checksum.json lists.
override_dh_clean:
	dh_clean -XCargo.toml.orig

override_dh_auto_clean:
	rm -rf target debian/cargo-home debian/home \
		debian/fnm.1 debian/fnm.bash debian/fnm.zsh debian/fnm.fish
